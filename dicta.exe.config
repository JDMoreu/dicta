<?xml version="1.0" encoding="utf-8"?>
<!-- Config de .NET Framework para dicta.exe (debe quedar AL LADO del .exe).

     Por que existe este fichero:
     La ventana del panel usa WebView2 via pywebview -> pythonnet ->
     clr_loader. clr_loader carga Python.Runtime.dll con Assembly.LoadFrom,
     y .NET Framework LANZA NotSupportedException ("An attempt was made to
     load an assembly from a network location...", HRESULT 0x80131515)
     cuando el fichero cae en la zona Internet/Intranet del sistema.
     Pasa con los ficheros del bundle (y con cualquiera descomprimido de un
     ZIP descargado de internet: la marca MOTW viaja con el fichero al
     extraerlo), asi que el motor .NET se negaba a cargar Python.Runtime y
     pywebview no podia abrir la ventana: el panel caia al respaldo de Chrome.

     `loadFromRemoteSources` es el interruptor oficial para ese caso y .NET lo
     lee de <exe>.exe.config antes de inicializar el CLR. Sin el, el .exe
     congelado nunca abre con WebView2.

     No requiere instalar nada: .NET Framework 4.x viene de serie en Windows. -->
<configuration>
  <runtime>
    <loadFromRemoteSources enabled="true" />
  </runtime>
</configuration>
